{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rda-exam.schema.json",
  "title": "RDA frozen exam",
  "description": "The shape of a frozen exam file, whether it comes from a real exam or was generated. Once an episode's study window opens, the file and its hash do not change.",
  "type": "object",
  "required": ["meta", "blueprint", "items"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "origin", "time_limit_minutes", "pass_line"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "origin": {
          "type": "string",
          "enum": ["real", "real-adapted", "ai-generated"]
        },
        "source": {
          "type": "string",
          "description": "Who published the exam and where it was obtained. Required for real and real-adapted."
        },
        "year": { "type": "integer" },
        "time_limit_minutes": { "type": "integer", "minimum": 1 },
        "pass_line": {
          "type": "object",
          "required": ["correct", "of"],
          "additionalProperties": false,
          "properties": {
            "correct": { "type": "integer", "minimum": 0 },
            "of": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "enum": ["real", "real-adapted"] } } },
          "then": { "required": ["source"] }
        }
      ]
    },
    "blueprint": {
      "type": "array",
      "minItems": 1,
      "description": "Topic areas and their weights, taken from the official content outline.",
      "items": {
        "type": "object",
        "required": ["topic", "weight_percent"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "weight_percent": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "difficulty", "stem", "options", "answer", "rationale", "source_citation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
          "stem": { "type": "string", "minLength": 1 },
          "options": {
            "type": "object",
            "required": ["A", "B", "C", "D"],
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 }
            }
          },
          "answer": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "rationale": { "type": "string", "minLength": 1 },
          "source_citation": {
            "type": "string",
            "minLength": 1,
            "description": "A primary reference the rationale relies on. Items without one are rejected."
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blind_runs": { "type": "integer", "minimum": 0 },
              "blind_agreement": { "type": "integer", "minimum": 0 },
              "human_checked": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
